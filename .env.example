# ==============================================================================
# Birrup Environment Configuration
# ==============================================================================

# 1. Supabase (Database & Backend)
# Get these free from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. AdsGram (Rewarded Video Ads Network for Telegram)
# Get your Block ID from: https://adsgram.ai
VITE_ADSGRAM_BLOCK_ID=YOUR_ADSGRAM_BLOCK_ID

# 3. Telegram Bot (Optional for direct WebApp notifications)
# Get your Bot Token from @BotFather
VITE_TELEGRAM_BOT_TOKEN=
